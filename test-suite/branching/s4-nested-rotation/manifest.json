{
  "schema": "branching-survey/v1",
  "id": "s4-nested-rotation",
  "variant": "clean",
  "title": "Oncologist Decision-Making in First-Line Metastatic NSCLC Immunotherapy",
  "intro": "Thank you for participating. This survey takes approximately 12 minutes. Your responses are confidential and reported only in aggregate.",
  "seed": 407,
  "questions": [
    {
      "id": "S1",
      "section": "SCREENER",
      "type": "radio",
      "text": "Which of the following best describes your primary clinical role?",
      "options": [
        { "code": 1, "label": "Medical oncologist" },
        { "code": 2, "label": "Hematologist-oncologist" },
        { "code": 3, "label": "Pulmonologist" },
        { "code": 4, "label": "Radiation oncologist" },
        { "code": 5, "label": "Other" }
      ],
      "rules": [
        { "if": { "q": "S1", "op": "eq", "value": 5 }, "terminate": "non-treater", "reason": "Does not treat metastatic NSCLC systemically." }
      ]
    },
    {
      "id": "S2",
      "section": "SCREENER",
      "type": "number",
      "text": "How many years have you been treating patients with non-small cell lung cancer?",
      "instruction": "Enter a whole number between 0 and 50.",
      "min": 0,
      "max": 50
    },
    {
      "id": "Q1",
      "section": "MAIN",
      "type": "checkbox",
      "text": "Which of the following immunotherapies for metastatic non-small cell lung cancer are you aware of?",
      "instruction": "Select all that apply.",
      "options": [
        { "code": 1, "label": "KEYTRUDA" },
        { "code": 2, "label": "OPDIVO" },
        { "code": 3, "label": "TECENTRIQ" },
        { "code": 4, "label": "IMFINZI" },
        { "code": 5, "label": "LIBTAYO" },
        { "code": 99, "label": "None of the above", "exclusive": true }
      ],
      "randomize": { "mode": "rotate", "anchorLastCodes": [99] }
    },
    {
      "id": "Q2",
      "section": "MAIN",
      "type": "radio",
      "text": "Do you routinely order PD-L1 biomarker testing before selecting first-line therapy for metastatic NSCLC?",
      "options": [
        { "code": 1, "label": "Yes" },
        { "code": 2, "label": "No" }
      ],
      "rules": [
        { "if": { "q": "Q2", "op": "eq", "value": 2 }, "goto": "Q7" }
      ]
    },
    {
      "id": "Q3",
      "section": "MAIN",
      "type": "radio",
      "text": "Approximately what share of your newly diagnosed metastatic NSCLC patients have PD-L1 expression of 50% or higher?",
      "options": [
        { "code": 1, "label": "Half or more" },
        { "code": 2, "label": "Fewer than half" },
        { "code": 3, "label": "Not sure" }
      ],
      "rules": [
        {
          "if": {
            "op": "or",
            "terms": [
              { "q": "Q3", "op": "eq", "value": 2 },
              { "q": "Q3", "op": "eq", "value": 3 }
            ]
          },
          "goto": "Q5"
        }
      ]
    },
    {
      "id": "Q4",
      "section": "MAIN",
      "type": "radio",
      "text": "For patients with PD-L1 expression of 50% or higher, what is your preferred first-line approach?",
      "options": [
        { "code": 1, "label": "Immunotherapy monotherapy" },
        { "code": 2, "label": "Immunotherapy plus chemotherapy" },
        { "code": 3, "label": "Chemotherapy alone" },
        { "code": 4, "label": "Other" }
      ],
      "rules": [
        { "goto": "Q6" }
      ]
    },
    {
      "id": "Q5",
      "section": "MAIN",
      "type": "radio",
      "text": "For patients with PD-L1 expression below 50%, what is your preferred first-line approach?",
      "options": [
        { "code": 1, "label": "Immunotherapy plus chemotherapy" },
        { "code": 2, "label": "Immunotherapy monotherapy" },
        { "code": 3, "label": "Chemotherapy alone" },
        { "code": 4, "label": "Other" }
      ]
    },
    {
      "id": "Q6",
      "section": "MAIN",
      "type": "radio",
      "text": "Which attribute most influences your choice of first-line immunotherapy?",
      "options": [
        { "code": 1, "label": "Overall survival data" },
        { "code": 2, "label": "Progression-free survival data" },
        { "code": 3, "label": "Tolerability profile" },
        { "code": 4, "label": "Dosing schedule convenience" },
        { "code": 5, "label": "Access and reimbursement" },
        { "code": 98, "label": "Other" }
      ],
      "randomize": { "mode": "shuffle", "anchorLastCodes": [98] }
    },
    {
      "id": "Q7",
      "section": "MAIN",
      "type": "number",
      "text": "What percentage of your metastatic NSCLC patients receive any immunotherapy in the first line?",
      "instruction": "Enter a whole number between 0 and 100.",
      "min": 0,
      "max": 100
    },
    {
      "id": "Q8",
      "section": "MAIN",
      "type": "rating",
      "text": "How likely are you to recommend first-line immunotherapy to a colleague treating metastatic NSCLC?",
      "instruction": "0 = Not at all likely, 10 = Extremely likely",
      "min": 0,
      "max": 10
    }
  ]
}
