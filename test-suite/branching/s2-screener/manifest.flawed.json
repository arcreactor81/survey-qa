{
  "schema": "branching-survey/v1",
  "id": "s2-screener",
  "variant": "flawed",
  "title": "Living with Migraine: Treatment Experiences and Preferences",
  "intro": "Thank you for your interest in this survey about migraine. It takes approximately 10 minutes. Your responses are confidential and reported only in aggregate.",
  "seed": 202,
  "questions": [
    {
      "id": "S1",
      "section": "SCREENER",
      "type": "number",
      "text": "What is your age?",
      "instruction": "Enter your age in years.",
      "min": 0,
      "max": 99,
      "rules": [
        {
          "if": {
            "q": "S1",
            "op": "lt",
            "value": 16
          },
          "terminate": "under-18",
          "reason": "Respondent is under 18 years of age."
        }
      ]
    },
    {
      "id": "S2",
      "section": "SCREENER",
      "type": "radio",
      "text": "Have you ever been diagnosed with migraine by a healthcare professional?",
      "options": [
        {
          "code": 1,
          "label": "Yes"
        },
        {
          "code": 2,
          "label": "No"
        }
      ],
      "rules": [
        {
          "if": {
            "q": "S2",
            "op": "eq",
            "value": 2
          },
          "terminate": "no-diagnosis",
          "reason": "No professional migraine diagnosis."
        }
      ]
    },
    {
      "id": "S3",
      "section": "SCREENER",
      "type": "radio",
      "text": "Do you or does anyone in your household work in any of the following industries?",
      "options": [
        {
          "code": 1,
          "label": "Market research"
        },
        {
          "code": 2,
          "label": "Pharmaceutical or biotechnology"
        },
        {
          "code": 3,
          "label": "Advertising or public relations"
        },
        {
          "code": 4,
          "label": "None of these"
        }
      ],
      "rules": []
    },
    {
      "id": "S4",
      "section": "SCREENER",
      "type": "number",
      "text": "On average, how many days per month do you experience migraine headaches?",
      "instruction": "Enter a whole number between 0 and 31.",
      "min": 0,
      "max": 31,
      "rules": [
        {
          "if": {
            "q": "S4",
            "op": "gt",
            "value": 15
          },
          "terminate": "quota-full-chronic",
          "reason": "Chronic migraine (15+ headache days) quota is full."
        }
      ]
    },
    {
      "id": "Q1",
      "section": "MAIN",
      "type": "checkbox",
      "text": "Which of the following do you currently use to treat a migraine attack when it happens?",
      "instruction": "Select all that apply.",
      "options": [
        {
          "code": 1,
          "label": "Prescription oral medication"
        },
        {
          "code": 2,
          "label": "Over-the-counter pain relievers"
        },
        {
          "code": 3,
          "label": "Injectable or nasal rescue treatment"
        },
        {
          "code": 4,
          "label": "Non-drug approaches (rest, dark room, ice, caffeine)"
        },
        {
          "code": 99,
          "label": "None of these",
          "exclusive": true
        }
      ]
    },
    {
      "id": "Q2",
      "section": "MAIN",
      "type": "radio",
      "text": "Are you currently using a preventive (daily or monthly) treatment for migraine?",
      "options": [
        {
          "code": 1,
          "label": "Yes, a daily oral preventive"
        },
        {
          "code": 2,
          "label": "Yes, an injectable preventive"
        },
        {
          "code": 3,
          "label": "No, but I am considering one"
        },
        {
          "code": 4,
          "label": "No, and I am not interested"
        }
      ]
    },
    {
      "id": "Q3",
      "section": "MAIN",
      "type": "radio",
      "text": "Overall, how satisfied are you with your current approach to managing migraine?",
      "options": [
        {
          "code": 1,
          "label": "Very satisfied"
        },
        {
          "code": 2,
          "label": "Somewhat satisfied"
        },
        {
          "code": 3,
          "label": "Neither satisfied nor dissatisfied"
        },
        {
          "code": 4,
          "label": "Somewhat dissatisfied"
        },
        {
          "code": 5,
          "label": "Very dissatisfied"
        }
      ]
    },
    {
      "id": "Q4",
      "section": "MAIN",
      "type": "rating",
      "text": "How much do migraines interfere with your daily activities?",
      "instruction": "0 = No interference, 10 = Complete interference",
      "min": 0,
      "max": 10
    },
    {
      "id": "Q5",
      "section": "MAIN",
      "type": "text",
      "text": "In your own words, what is the most frustrating part of managing your migraines?"
    },
    {
      "id": "Q6",
      "section": "MAIN",
      "type": "radio",
      "text": "How likely are you to ask your doctor about a new preventive migraine treatment in the next 6 months?",
      "options": [
        {
          "code": 1,
          "label": "Definitely will"
        },
        {
          "code": 2,
          "label": "Probably will"
        },
        {
          "code": 3,
          "label": "Might or might not"
        },
        {
          "code": 4,
          "label": "Probably will not"
        },
        {
          "code": 5,
          "label": "Definitely will not"
        }
      ]
    }
  ],
  "basedOn": "manifest.json",
  "seededErrors": [
    {
      "id": "S2-E01",
      "category": "terminate-not-enforced",
      "location": "S3, rule 1",
      "description": "Docx says TERMINATE IF S3 IS NOT 4 (industry conflict); the site never terminates on S3 and lets conflicted respondents through.",
      "patch": [
        {
          "op": "remove",
          "path": "/questions/2/rules/0"
        }
      ]
    },
    {
      "id": "S2-E02",
      "category": "wrong-threshold",
      "location": "S1, rule 1",
      "description": "Docx says TERMINATE IF S1 < 18; the site terminates only under 16, so 16-17 year olds qualify.",
      "patch": [
        {
          "op": "replace",
          "path": "/questions/0/rules/0/if/value",
          "value": 16
        }
      ]
    },
    {
      "id": "S2-E03",
      "category": "boundary-off-by-one",
      "location": "S4, rule 1",
      "description": "Docx says TERMINATE IF S4 >= 15 (chronic quota full); the site uses strictly-greater-than, so exactly 15 headache days incorrectly qualifies.",
      "patch": [
        {
          "op": "replace",
          "path": "/questions/3/rules/0/if/op",
          "value": "gt"
        }
      ]
    }
  ]
}
