{
  "schema": "branching-survey/v1",
  "id": "s3-multiselect-piping",
  "variant": "flawed",
  "title": "Clinician Use of Incretin-Based Therapies in Type 2 Diabetes",
  "intro": "Thank you for participating. This survey takes approximately 10 minutes. Your responses are confidential and reported only in aggregate.",
  "seed": 303,
  "questions": [
    {
      "id": "S1",
      "section": "SCREENER",
      "type": "radio",
      "text": "Which of the following best describes your primary clinical role?",
      "options": [
        {
          "code": 1,
          "label": "Primary care physician"
        },
        {
          "code": 2,
          "label": "Endocrinologist"
        },
        {
          "code": 3,
          "label": "Nurse practitioner"
        },
        {
          "code": 4,
          "label": "Physician assistant"
        }
      ]
    },
    {
      "id": "S2",
      "section": "SCREENER",
      "type": "number",
      "text": "How many years have you been in clinical practice?",
      "instruction": "Enter a whole number between 0 and 50.",
      "min": 0,
      "max": 50
    },
    {
      "id": "Q1",
      "section": "MAIN",
      "type": "checkbox",
      "text": "Which of the following GLP-1 or dual-incretin therapies do you currently prescribe for type 2 diabetes?",
      "instruction": "Select all that apply.",
      "options": [
        {
          "code": 1,
          "label": "OZEMPIC"
        },
        {
          "code": 2,
          "label": "MOUNJARO"
        },
        {
          "code": 3,
          "label": "TRULICITY"
        },
        {
          "code": 4,
          "label": "RYBELSUS"
        },
        {
          "code": 99,
          "label": "None of the above",
          "exclusive": true
        }
      ],
      "rules": [
        {
          "if": {
            "q": "Q1",
            "op": "includes",
            "value": 99
          },
          "goto": "Q5"
        }
      ]
    },
    {
      "id": "Q2",
      "section": "MAIN",
      "type": "radio",
      "text": "Which one of these therapies do you prescribe most often for type 2 diabetes?",
      "options": [
        {
          "code": 1,
          "label": "OZEMPIC"
        },
        {
          "code": 2,
          "label": "MOUNJARO"
        },
        {
          "code": 3,
          "label": "TRULICITY"
        },
        {
          "code": 4,
          "label": "RYBELSUS"
        }
      ]
    },
    {
      "id": "Q3",
      "section": "MAIN",
      "type": "radio",
      "text": "How satisfied are you with {Q2drug} for your type 2 diabetes patients?",
      "options": [
        {
          "code": 1,
          "label": "Very satisfied"
        },
        {
          "code": 2,
          "label": "Somewhat satisfied"
        },
        {
          "code": 3,
          "label": "Neither satisfied nor dissatisfied"
        },
        {
          "code": 4,
          "label": "Somewhat dissatisfied"
        },
        {
          "code": 5,
          "label": "Very dissatisfied"
        }
      ],
      "piping": {
        "source": "Q2",
        "note": "Insert the therapy selected at Q2 into the question text."
      },
      "rules": [
        {
          "if": {
            "q": "Q1",
            "op": "countGte",
            "value": 3
          },
          "goto": "Q5"
        }
      ]
    },
    {
      "id": "Q4",
      "section": "MAIN",
      "type": "radio",
      "text": "You prescribe three or more incretin-based therapies. What is the main factor that determines which one a new patient starts on?",
      "options": [
        {
          "code": 1,
          "label": "Glycemic efficacy"
        },
        {
          "code": 2,
          "label": "Weight-loss benefit"
        },
        {
          "code": 3,
          "label": "Cardiovascular outcomes data"
        },
        {
          "code": 4,
          "label": "Insurance coverage and access"
        },
        {
          "code": 5,
          "label": "Patient preference for device or administration"
        }
      ]
    },
    {
      "id": "Q5",
      "section": "MAIN",
      "type": "radio",
      "text": "What is the single biggest barrier to starting patients on an incretin-based therapy?",
      "options": [
        {
          "code": 1,
          "label": "Insurance / prior authorization requirements"
        },
        {
          "code": 2,
          "label": "Out-of-pocket cost to patients"
        },
        {
          "code": 3,
          "label": "Product supply or availability"
        },
        {
          "code": 4,
          "label": "Patient reluctance to use injectables"
        },
        {
          "code": 5,
          "label": "Other"
        }
      ]
    },
    {
      "id": "Q6",
      "section": "MAIN",
      "type": "number",
      "text": "What percentage of your type 2 diabetes patients are currently on any incretin-based therapy?",
      "instruction": "Enter a whole number between 0 and 100.",
      "min": 0,
      "max": 100
    },
    {
      "id": "Q7",
      "section": "MAIN",
      "type": "rating",
      "text": "How likely are you to recommend incretin-based therapy to a colleague managing type 2 diabetes?",
      "instruction": "0 = Not at all likely, 10 = Extremely likely",
      "min": 0,
      "max": 10
    }
  ],
  "basedOn": "manifest.json",
  "seededErrors": [
    {
      "id": "S3-E01",
      "category": "broken-piping",
      "location": "Q3, question text",
      "description": "Docx pipes the Q2 selection into Q3; the site references an unknown token and renders the literal text {Q2drug}.",
      "patch": [
        {
          "op": "replace",
          "path": "/questions/4/text",
          "value": "How satisfied are you with {Q2drug} for your type 2 diabetes patients?"
        }
      ]
    },
    {
      "id": "S3-E02",
      "category": "carry-forward-broken",
      "location": "Q2, option list",
      "description": "Docx says show only the therapies selected at Q1; the site shows the full static brand list regardless of the Q1 selection.",
      "patch": [
        {
          "op": "remove",
          "path": "/questions/3/optionsFrom"
        },
        {
          "op": "add",
          "path": "/questions/3/options",
          "value": [
            {
              "code": 1,
              "label": "OZEMPIC"
            },
            {
              "code": 2,
              "label": "MOUNJARO"
            },
            {
              "code": 3,
              "label": "TRULICITY"
            },
            {
              "code": 4,
              "label": "RYBELSUS"
            }
          ]
        }
      ]
    },
    {
      "id": "S3-E03",
      "category": "inverted-branch",
      "location": "Q3, rule 1",
      "description": "Docx says IF FEWER THAN 3 SELECTED AT Q1 SKIP TO Q5; the site inverts the condition (3 or more skip), so Q4 is shown to exactly the wrong respondents.",
      "patch": [
        {
          "op": "replace",
          "path": "/questions/4/rules/0/if/op",
          "value": "countGte"
        }
      ]
    }
  ]
}
