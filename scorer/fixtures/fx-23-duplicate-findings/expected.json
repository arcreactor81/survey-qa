      "op": "eq",
      "value": 3
    },
    {
      "path": "defects.truePositives.length",
      "op": "eq",
      "value": 2
    },
    {
      "path": "defects.redundant.length",
      "op": "eq",
      "value": 1
    },
    {
      "path": "defects.redundant.0.defectId",
      "op": "eq",
      "value": "ORC-DEF-2"
    },
    {
      "path": "defects.falsePositives.length",
      "op": "eq",
      "value": 0
    },
    {
      "path": "defects.ambiguous.length",
      "op": "eq",
      "value": 0
    },
    {
      "path": "defects.precisionDenominator",
      "op": "eq",
      "value": 2
    },
    {
      "path": "metrics.seededDefectRecall",
      "op": "eq",
      "value": 1
    },
    {
      "path": "metrics.seededDefectPrecision",
      "op": "eq",
      "value": 1
    },
    {
