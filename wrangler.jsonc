{
  "name": "survey-qa",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/reports/*"]
  },
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "survey-qa-artifacts" }
  ],
  "workflows": [
    { "name": "survey-qa-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" }
  ],
  // NOTE FOR CLONERS: the store_id below and CF_AIG_ACCOUNT_ID / CF_AIG_GATEWAY_ID
  // near the bottom are the original author's Cloudflare account-specific identifiers.
  // They are identifiers, not secrets — but a fresh clone will NOT deploy until you
  // replace them with your own (your Secrets Store id, your AI Gateway account id +
  // gateway name). See "Deploy your own instance" in README.md.
  "secrets_store_secrets": [
    {
      "binding": "DEEPSEEK_API_KEY",
      "store_id": "55e6ce4174d645cfa68a6c27eef7847f",
      "secret_name": "DEEPSEEK_API_KEY"
    },
    {
      "binding": "XAI_API_KEY",
      "store_id": "55e6ce4174d645cfa68a6c27eef7847f",
      "secret_name": "XAI_API_KEY"
    },
    {
      "binding": "ANTHROPIC_API_KEY",
      "store_id": "55e6ce4174d645cfa68a6c27eef7847f",
      "secret_name": "ANTHROPIC_API_KEY"
    }
  ],
  "vars": {
    "BENCH_ENDPOINTS_ENABLED": "false",
    "CLAUDE_MODEL": "claude-sonnet-4-6",
    "DEEPSEEK_MODEL": "deepseek-v4-pro",
    "CLAUDE_INPUT_USD_PER_MTOK": "3",
    "CLAUDE_OUTPUT_USD_PER_MTOK": "15",
    "DEEPSEEK_INPUT_USD_PER_MTOK": "0.28",
    "DEEPSEEK_OUTPUT_USD_PER_MTOK": "0.42",
    "WORKERSAI_MODEL": "@cf/openai/gpt-oss-120b",
    "WORKERSAI_INPUT_USD_PER_MTOK": "0.35",
    "WORKERSAI_OUTPUT_USD_PER_MTOK": "0.75",
    "WORKERSAI_ENABLED": "false",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "GEMINI_INPUT_USD_PER_MTOK": "0.30",
    "GEMINI_OUTPUT_USD_PER_MTOK": "2.50",
    "GROK_MODEL": "grok-4.3",
    "GROK_INPUT_USD_PER_MTOK": "1.25",
    "GROK_OUTPUT_USD_PER_MTOK": "2.50",
    "CF_AIG_ACCOUNT_ID": "f0cbb2076e484454e6567789b9be85d8",
    "CF_AIG_GATEWAY_ID": "firstgateway"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
